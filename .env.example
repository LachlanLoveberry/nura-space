# Copy this file to .env.local and fill in the values.

# Secret used to sign JWT session tokens
JWT_SECRET=change_me

# Secret used to authorize admin live-message pushes
LIVE_MESSAGE_SECRET=change_me

# Base URL for the Open-Meteo weather API
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# Origin allowed for the app (used for cookie/CORS handling)
APP_ORIGIN=http://localhost:3000

# Set to "1" to enable verbose auth debug logging (optional)
AUTH_DEBUG=
